<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ZeroMenuTime.Server</AssemblyName>
    <Version>1.2.2</Version>
    <RootNamespace>ZeroMenuTime.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The SPT copy of the game. Override with: dotnet build -p:GameDir=X:\path\ -->
    <GameDir Condition=" '$(GameDir)' == '' ">F:\SPT\</GameDir>
    <SptRuntime>$(GameDir)SPT_Runtime\</SptRuntime>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptRuntime)SPTarkov.Common.dll</HintPath></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptRuntime)SPTarkov.DI.dll</HintPath></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptRuntime)SPTarkov.Server.Core.dll</HintPath></Reference>
    <Reference Include="Vagabond.Common"><HintPath>$(SptRuntime)user\mods\Vagabond\Vagabond.Common.dll</HintPath></Reference>
    <Reference Include="SPTarkov.Reflection"><HintPath>$(SptRuntime)SPTarkov.Reflection.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptRuntime)0Harmony.dll</HintPath></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SptRuntime)SemanticVersioning.dll</HintPath></Reference>
  </ItemGroup>
</Project>
